### =========================================================================
### ПОЛНЫЙ МОНОХРОМНЫЙ КОНФИГ SWAY (СПИРАЛЬНЫЙ ЛЕЙАУТ + DMENU)
### =========================================================================

# Клавиша-модификатор (Mod4 = Клавиша Windows / Super)
set $mod Mod4

# Направление движения окон (стиль Vim)
set $left h
set $down j
set $up k
set $right l

# Названия программ по умолчанию (Rio и dmenu в монохроме)
set $term rio
set $menu dmenu_run -nb '#000000' -nf '#ffffff' -sb '#ffffff' -sf '#000000' -fn 'monospace-10'

### --- 1. АВТОЗАПУСК И СЕРВИСЫ ----------------------------------------------

# Автоматический спиральный лейаут окон (как в Hyprland)
exec_always autotiling-rs

# Обои (Чистый глубокий чёрный цвет для монохромного стиля)
output * bg #000000 solid

### --- 2. НАСТРОЙКИ УСТРОЙСТВ ВВОДА ----------------------------------------

# Раскладка клавиатуры (переключение по Alt + Shift, Caps Lock свободен)
input "type:keyboard" {
    xkb_layout us,ru
    xkb_options grp:alt_shift_toggle
}

# Настройки тачпада (если у вас ноутбук)
input "type:touchpad" {
    dwt enabled
    tap enabled
    natural_scroll enabled
}

### --- 3. ЦВЕТОВАЯ СХЕМА "TRUE MONOCHROME" ----------------------------------

# Палитра цветов
set $black       #000000
set $dark_gray   #222222
set $light_gray  #888888
set $white       #ffffff

# Оформление окон       рамка       фон         текст       индикатор   дочерн.рамка
client.focused          $white      $black      $white      $white      $white
client.focused_inactive $dark_gray  $black      $light_gray $dark_gray  $dark_gray
client.unfocused        $dark_gray  $black      $light_gray $dark_gray  $dark_gray
client.urgent           $white      $white      $black      $white      $white

# Размеры рамок и отступы (gaps)
default_border pixel 2
default_floating_border pixel 2
gaps inner 8
gaps outer 4

### --- 4. ГОРЯЧИЕ КЛАВИШИ (ХОТКЕИ) -----------------------------------------

## Системные действия
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec swaynag -t warning -m 'Выйти из Sway?' -B 'Да' 'swaymsg exit'

## Закрытие активного окна
bindsym $mod+c kill

## Запуск приложений
bindsym $mod+q exec $term
bindsym $mod+space exec $menu

## Управление фокусом (Vim-style)
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right

## Перемещение окон (Vim-style)
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right

## Рабочие пространства (Воркспейсы)
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

## Перенос окон на пространства
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

## Режимы окон и управление
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+space floating toggle

### --- 5. МУЛЬТИМЕДИА КЛАВИШИ ----------------------------------------------

# Громкость звука (работает через pactl)
bindcode 122 exec pactl set-sink-volume @DEFAULT_SINK@ -5%
bindcode 123 exec pactl set-sink-volume @DEFAULT_SINK@ +5%
bindcode 121 exec pactl set-sink-mute @DEFAULT_SINK@ toggle

# Яркость экрана (требуется утилита brightnessctl)
bindcode 232 exec brightnessctl set 5%-
bindcode 233 exec brightnessctl set +5%
