[theme]
theme = "solarized-dark" # Базовая тема, которую мы ниже перекрасим в монохром

[theme.overrides]
idle_bg = "#000000"
idle_fg = "#ffffff"
good_bg = "#000000"
good_fg = "#ffffff"
warning_bg = "#ffffff"
warning_fg = "#000000"
critical_bg = "#ffffff"
critical_fg = "#000000"
separator = " | "

[[block]]
block = "disk_space"
path = "/"
info_type = "available"
interval = 60
format = " $icon $available "

[[block]]
block = "memory"
format = " $icon $mem_used_percents "

[[block]]
block = "cpu"
interval = 5

[[block]]
block = "sound"

[[block]]
block = "time"
interval = 60
format = " $timestamp.datetime(f:'%a %d/%m %R') "
